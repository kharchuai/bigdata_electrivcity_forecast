# These addresses are for jobs inside the Compose network.
PGHOST=postgres
PGPORT=5432
PGDATABASE=electricity
PGUSER=electricity
PGPASSWORD=electricity_local_change_me
PG_PUBLISHED_PORT=55432

ICEBERG_DATABASE=iceberg_catalog
ICEBERG_USER=electricity
ICEBERG_PASSWORD=electricity_local_change_me

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Keep these bootstrap values equal to configs/local.yaml.
KAFKA_TOPIC=electricity_readings
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
HDFS_ROOT_URI=hdfs://namenode:8020/electricity
SPARK_MASTER_URL=local[2]

# Publish web interfaces on the host only.
HDFS_UI_PORT=9870
SPARK_UI_PORT=4040

# Needed only in later steps, when Airflow is implemented.
AIRFLOW_BASE_URL=http://airflow-webserver:8080
AIRFLOW_API_TOKEN=
